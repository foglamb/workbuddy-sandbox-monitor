{
  "name": "workbuddy-sandbox-monitor",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "docker:build": "docker build -t workbuddy-monitor:latest .",
    "docker:run": "docker run --rm -p 127.0.0.1:8788:8788 -v workbuddy-data:/app/data -e WB_ADMIN_TOKEN workbuddy-monitor:latest",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f --tail=100",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
