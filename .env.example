# WorkBuddy 保活平台 —— 环境变量示例
#
# 复制为 .env 后按需修改：cp .env.example .env && chmod 600 .env
# 不带 # 前缀的行是需要你填写的项。

# ---- 必填 ----

# 管理台口令，8–128 位字母、数字、下划线或连字符。
# 首次登录用它；登录后可在「统一设置 → 管理口令」里改，数据库中的值优先于这里。
WB_ADMIN_TOKEN=

# ---- Docker 端口发布 ----
#
# 仅在使用 docker compose 时生效。默认只绑回环地址，局域网访问改成 0.0.0.0:8788。
# WB_PUBLISH=0.0.0.0:8788

# ---- 检查记录保留 ----
#
# 每个网址保留的检查记录条数，0–1000000。
# 0（默认）= 永久保留。网址"什么时候开始坏的"这类问题需要长期数据才能回答，
# 裁剪等于删除现场。若磁盘吃紧可设上限（如 5000）。
WB_HISTORY_LIMIT=0

# ---- 监听 ----

# 监听地址。127.0.0.1 只允许本机访问；0.0.0.0 允许外部访问（此时必须设置口令）。
WB_HOST=127.0.0.1
WB_PORT=8788

# 管理台对外地址，含协议、主机和端口。HTTP 与 HTTPS 均可。
# 例如 http://10.0.0.5:8788 或 https://monitor.example.com
WB_WEB_ORIGIN=

# ---- 数据 ----

# 数据目录。包含 monitor.sqlite、加密密钥 monitor.sqlite.python-key 和 python-tasks/ 子目录。
# 备份时必须三者一起拷贝，否则已保存的令牌无法解密。
WB_DATA_DIR=data

# ---- 网址监控 ----

# 网址检查的并行数，1–8。
WB_CONCURRENCY=4

# 额外禁止监控的域名，逗号分隔。匹配域名自身及所有子域。
# 用于把自家基础设施排除在探测范围之外。内置禁用项始终生效、无法通过此变量移除。
WB_DENIED_DOMAINS=

# 可选的部署来源白名单，逗号分隔的完整来源。
# 例如 https://a.example.com,https://b.example.com:8443
WB_ALLOWED_ORIGINS=

# ---- Python 脚本 ----

# 每份配置在数据库中保留的日志行数，100–5000。
WB_LOG_LINES=1000

# 单个 Python 进程的常驻内存（RSS）上限，单位 MiB，128–8192。
# 连续 3 次采样超过该值才会停止进程；正常占用约 21–24 MiB。
WB_MEMORY_CEILING_MB=512

# 同时运行的脚本份数上限。0 表示不限制。
WB_MAX_RUNS=0

# 磁盘日志文件体积上限，单位 MiB，1–64。超过后下次启动前轮转。
WB_LOG_FILE_MB=4

# ---- 实例保活（可选，不需要就留空）----
#
# 仅在需要给腾讯云 Agent Runtime 沙箱实例自动续期时填写。
# 格式为 JSON 数组，每项需要 id、label、region、instanceId，
# 并在环境变量中提供 <credential>_SECRET_ID / <credential>_SECRET_KEY。
#
# WB_AGS_BINDINGS=[{"id":"sandbox-1","label":"演示实例","region":"ap-guangzhou","instanceId":"sbe-xxxxxxxx","credential":"TENCENTCLOUD"}]
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
WB_AGS_BINDINGS=[]
